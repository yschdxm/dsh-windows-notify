{
  "name": "@yschdxm/dsh-windows-notify",
  "version": "2.0.0",
  "description": "Native Windows toast notifications for DeepSeek Harness: task completion, approval, questions, sign-in; click a toast to focus the app and jump back to that conversation.",
  "type": "module",
  "license": "MIT",
  "author": "yschdxm",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "format.js",
    "client.js",
    "toast.ps1",
    "launcher.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "notification",
    "notify",
    "toast",
    "windows",
    "toast-notification",
    "session-jump",
    "click-to-focus",
    "approval",
    "question"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yschdxm/dsh-windows-notify.git"
  },
  "homepage": "https://github.com/yschdxm/dsh-windows-notify#readme",
  "bugs": {
    "url": "https://github.com/yschdxm/dsh-windows-notify/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      },
      "node": ">=20"
    }
  }
}
